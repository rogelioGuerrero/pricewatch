__pycache__/
*.pyc
node_modules/
.playwright-mcp/

# Datos vivos (DBs, snapshots, logs de eventos): viven en el cache de
# Actions (pwdata-*), no en git. El bootstrap del workflow rescata los
# logs del último commit si el cache llega vacío.
data/*.db
data/snapshots/
data/siman_snapshots/
data/events.jsonl
data/siman_events.jsonl

# Outputs del build: build_site.py los regenera en cada corrida y el
# sitio se publica como artefacto de Pages — no viven en git.
docs/index.html
docs/data.json
docs/version.json

# Memoria MCP local (grafo de conocimiento del agente)
.devin/mcp_config.local.json
.devin/memory.json
